# EDGE RESCUE — Environment Configuration
# Copy this file to .env or env

# PostgreSQL Database (Supabase / Neon / Docker default)
DATABASE_URL=postgresql+psycopg://zerohour:zerohour@localhost:5432/zerohour

# Redis Pub/Sub & Telemetry Cache
REDIS_URL=redis://localhost:6379

# Google AI Studio API Key for Gemma 4 26B Hub Model
# Get a key at: https://aistudio.google.com/apikey
# NOTE: If unset, EDGE RESCUE seamlessly runs in 100% offline mode with rule-based triage & algorithmic ranking.
GEMINI_API_KEY=AQ.Ab8RN6K9UPox0kwqqMPrOC_-R8h3x2axVKEvui-8ltlMcL2MGQ

# Gemma Models
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_TRIAGE_MODEL=gemma-4-e2b-it
